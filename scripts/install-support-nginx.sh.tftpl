#!/bin/bash
export HTTP_PROXY="${http_proxy}"
export HTTPS_PROXY="${http_proxy}"
export http_proxy="${http_proxy}"
export https_proxy="${http_proxy}"

nginx() {
    echo "\e[1;33;4;44mInstalling NGINX and Streaming Module.....\e[0m" &&
    DEBIAN_FRONTEND=noninteractive sudo -E apt-get update &&
    DEBIAN_FRONTEND=noninteractive sudo -E apt-get install -y libnginx-mod-stream nginx &&
    echo "\e[1;33;4;44mNGINX installed.\e[0m"
}

nginx