load_module /usr/lib/nginx/modules/ngx_stream_module.so;

events {
    worker_connections 786;
}

stream {
    upstream talos_servers_k8s_api {
        %{ for host in talos_control_plane_nodes ~}
        server ${host};
        %{ endfor ~}
    }

    server {
        listen 6443;
        proxy_pass talos_servers_k8s_api;
    }

    upstream talos_nodes_ingress_https {
        %{ for ip in talos_nodes ~}
        server ${ip}:443;
        %{ endfor ~}
    }

    server {
        listen 443;
        proxy_pass talos_nodes_ingress_https;
    }

    upstream talos_nodes_ingress_http {
        %{ for ip in talos_nodes ~}
        server ${ip}:80;
        %{ endfor ~}
    }

    server {
        listen 80;
        proxy_pass talos_nodes_ingress_http;
    }
    
%{ for additional_lb_port in additional_lb_ports ~}
    upstream talos_${additional_lb_port} {
        %{ for ip in talos_nodes ~}
        server ${ip}:${additional_lb_port};
        %{ endfor ~}
    }

    server {
        listen ${additional_lb_port};
        proxy_pass talos_${additional_lb_port};
    }
%{ endfor ~}
}
