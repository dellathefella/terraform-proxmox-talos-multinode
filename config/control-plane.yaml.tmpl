machine:
  install:
    disk: ${jsonencode(install_disks)}
  network:
    hostname: ${hostname}
# https://www.talos.dev/v1.7/talos-guides/configuration/time-sync/#additional-configuration
  time:
    servers:
      - /dev/ptp0

cluster:
  etcd:
    extraArgs:
      quota-backend-bytes: 8589934592
  clusterName: ${cluster_name}
  allowSchedulingOnControlPlanes: false
%{ if length(api_hostnames) > 0 ~}
  apiServerCert:
    sans:
%{ for hostname in api_hostnames ~}
      - ${hostname}
%{ endfor ~}
%{ endif ~}
