machine:
  install:
    disk: ${install_disk}
  network:
    hostname: ${hostname}
# https://www.talos.dev/v1.7/talos-guides/configuration/time-sync/#additional-configuration
  time:
    servers:
      - /dev/ptp0
  kubelet:
    extraMounts:
      - destination: /var/lib/longhorn
        type: bind
        source: /var/lib/longhorn
        options:
          - bind
          - rshared
          - rw

cluster:
  clusterName: ${cluster_name}
  allowSchedulingOnControlPlanes: false
  inlineManifests:
  - name: longhorn-install
    contents: |
      ${indent(6, longhorn_install)}
  - name: flux-install
    contents: |
      ${indent(6, flux_install)}